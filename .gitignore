# ============================================
# CryptoCTF - GitIgnore
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.Python

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- Challenge Workspace (local only) ----
# These are YOUR working directories for solving CTFs.
# They stay on disk, never pushed to GitHub.
challenges/
test_challenges/
validation_challenges/

# ---- Runtime Databases ----
*.db
*.sqlite
*.sqlite3

# ---- FAISS Indexes (regenerable) ----
*.faiss
experience_ids.json

# ---- Training Data (too large for git) ----
data/external/
data/*.jsonl
data/*.json
!data/experiences/*.json

# ---- Large ML Models (regenerable via training) ----
trained_model/
trained_predictor/
*.model
*.safetensors
*.bin
model_checkpoints/

# ---- Trained lightweight is KEPT (small, <400KB) ----
# trained_lightweight/ is NOT ignored

# ---- Logs & Ephemeral Files ----
*.log
connection.log
traces.json
flag.txt
*.pid

# ---- One-off / Scratch Files ----
try_*.py
brute_*.py
probe_*.py
find_offset.py

# ---- Build Artifacts & Archives ----
*.tar.gz
*.zip
*.rar
*.7z
*.tgz

# ---- API Keys & Secrets ----
.env
.env.*
**/secrets.json
**/api_keys.json
config/secrets.py

# ---- Node.js (if frontend used) ----
node_modules/
npm-debug.log*

# ---- Jupyter ----
.ipynb_checkpoints

# ---- mypy / pytest ----
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ---- RAG Data (legacy paths) ----
rag/data/chroma_db/
rag/data/*.json
rag/data/*.jsonl
*.chromadb

# ---- External Tools ----
RsaCtfTool/